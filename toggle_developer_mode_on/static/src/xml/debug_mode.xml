<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="toggle_developer_mode_on.DebugMode">
        <div class="d-flex align-items-center">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="devModeToggle" 
                       t-att-checked="state.is_dev_mode"
                       t-on-change="toggle_dev_mode"/>
                <label class="form-check-label" for="devModeToggle">
                </label>
            </div>
        </div>
    </t>

</templates>
